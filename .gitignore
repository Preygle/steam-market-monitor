# --- personal data: never commit -------------------------------------
# Comments must sit on their own line: git reads a trailing "# ..." as part
# of the pattern, which silently stops the pattern from matching anything.

# SteamID, cost basis, session cookie
config/config.yaml
# your specific holdings
config/watchlist.yaml
# inventory snapshots with real prices/costs
scripts/snapshot_*.py
# local SQLite db, cached HTTP responses
data/*
!data/.gitkeep
*.db

# --- python ----------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# --- editors / os ----------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
